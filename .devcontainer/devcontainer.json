{
  "name": "My Dev Environment",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "configureZshAsDefaultShell": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/python:1.8.0": {
      "version": "3.14",
      "toolsToInstall": "ruff,pytest,mypy"
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "24",
      "pnpmVersion": "latest",
      "yarnVersion": "latest"
    },
    "ghcr.io/devcontainers/features/ruby:2.0.0": {
      "version": "4.0"
    },
    "./features/rails": {
      "version": "8.1.3.1"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {
      "moby": true,
      "installDockerBuildx": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainer-community/devcontainer-features/chezmoi.io:1.0.4": {},

    // === Optional development environments ===
    // Delete the // to enable one or more of these Features.
    // Versions are pinned so the template remains reproducible.

    // Frontend / full-stack
    // "ghcr.io/michidk/devcontainers-features/bun:1.0.1": {},

    // Backend
    // "ghcr.io/devcontainers/features/go:1.3.4": {},
    // "ghcr.io/devcontainers/features/java:1.8.3": {},
    // "ghcr.io/devcontainers/features/php:1.1.5": {},
    // "ghcr.io/devcontainers/features/dotnet:2.5.0": {},
    // "ghcr.io/devcontainers/features/rust:1.5.1": {},

    // Cloud / infrastructure
    // "ghcr.io/devcontainers/features/aws-cli:1.1.4": {},
    // "ghcr.io/devcontainers/features/azure-cli:1.3.0": {},
    // "ghcr.io/joshuanianji/devcontainer-features/google-cloud-cli:1.0.0": {},
    // "ghcr.io/devcontainers/features/terraform:1.5.0": {},
    // "ghcr.io/devcontainers/features/kubectl-helm-minikube:1.3.1": {},
    // "ghcr.io/devcontainers/features/github-cli:1.1.2": {}
  },
  "mounts": [
    "source=devcontainer-home-${devcontainerId},target=/home/vscode,type=volume"

    // === Custom workspace mounts ===
    // Replace the source path with a REAL absolute path on your host, then uncomment.
    // Keep target under /workspace and add one entry for each directory you want to share.
    // Example:
    // "source=/home/your-user/projects,target=/workspace/projects,type=bind,consistency=cached"
    // "source=/home/your-user/data,target=/workspace/data,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "DOTFILES_REPOSITORY": "${localEnv:DOTFILES_REPOSITORY}"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscodevim.vim",
        "ms-python.python",
        "charliermarsh.ruff",
        "Shopify.ruby-lsp",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/zsh/install.sh"
}
