{
  "name": "My Dev Environment",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "configureZshAsDefaultShell": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/python:1.8.0": {
      "version": "3.14",
      "toolsToInstall": "ruff,pytest,mypy"
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "24",
      "pnpmVersion": "latest",
      "yarnVersion": "latest"
    },
    "ghcr.io/devcontainers/features/ruby:2.0.0": {
      "version": "4.0"
    },
    "./features/rails": {
      "version": "8.1.3.1"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {
      "moby": true,
      "installDockerBuildx": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainer-community/devcontainer-features/chezmoi.io:1.0.4": {}
  },
  "mounts": [
    "source=devcontainer-home-${devcontainerId},target=/home/vscode,type=volume"
  ],
  "containerEnv": {
    "DOTFILES_REPOSITORY": "${localEnv:DOTFILES_REPOSITORY}"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscodevim.vim",
        "ms-python.python",
        "charliermarsh.ruff",
        "Shopify.ruby-lsp",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/zsh/install.sh"
}
